# Talaria Agent — minimal config
#
# Most users never need to touch this file: `talaria setup` writes a working
# config for the chosen provider. Drop this in `~/.talaria/config.yaml` only
# if you want to override defaults by hand.
#
# Looking for an option not listed here? See cli-config.yaml.full.example for
# the exhaustive, commented reference of every supported key.

# --- The one thing 80% of users set --------------------------------------
model:
  default: "anthropic/claude-opus-4.6"      # `provider/model` or just `model`
  provider: "auto"                          # auto | anthropic | openai | openai-codex | openrouter | xiaomi | lmstudio | custom
  # base_url: "https://openrouter.ai/api/v1"   # required for custom / local

# --- Terminal backend (rarely changed) -----------------------------------
# Where shell tools run. Default = local. Switch to "docker" for an
# isolated container, or "ssh" to drive a remote box.
# terminal:
#   backend: "local"   # local | docker | ssh

# --- Agent loop knobs ----------------------------------------------------
# Sensible defaults already; tweak only if you hit them.
# agent:
#   max_turns: 50
#   context_pad_tokens: 4096

# --- Per-platform tools --------------------------------------------------
# Restrict which toolset each messaging surface exposes. Omit to allow all.
# platform_toolsets:
#   discord: ["chat", "memory"]
#   telegram: ["chat"]

# Secrets (API keys, bot tokens) live in `~/.talaria/.env`, not here.
