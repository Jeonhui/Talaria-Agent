digraph TalariaIntegration {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, splines=ortho, nodesep=0.35, ranksep=0.5, compound=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#444444"];
  edge  [fontname="Helvetica", fontsize=9, color="#666666"];

  // ---- integration node style (red overlay) ----
  // nodes prefixed with INTEG_ use this look via attributes below

  // ================= BOOT =================
  subgraph cluster_boot {
    label="BOOT — once at process start (global)";
    style="rounded"; color="#999999"; fontsize=12;

    plugins_import [label="talaria_cli / plugins import\nregister(ctx), hooks, tools\n→ global registries"];
    mcp_spawn      [label="MCP server spawn / connect\n(tools/mcp_tool.py)\nregister mcp_<srv>_<tool>"];
    builtin        [label="Built-in toolsets\ntodo / memory / terminal / web ..."];

    INTEG_load [label="★ integrations loader\nintegrations/__init__.py\nload active module (config)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
    INTEG_mcp  [label="★ module MCP register\nbridge.mcp_server_config()\n→ register_mcp_servers\n(inherits AUTO-RECONNECT ∞)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];

    tool_registry [label="TOOL REGISTRY (global singleton)\nbuilt-in + MCP tools + _generation", fillcolor="#f1f3f5"];
  }

  plugins_import -> tool_registry;
  mcp_spawn      -> tool_registry;
  builtin        -> tool_registry;
  INTEG_mcp      -> tool_registry [color="#c92a2a", style=dashed, label="mcp_<mod>_*"];
  INTEG_load     -> INTEG_mcp     [color="#c92a2a", style=dashed];

  // ================= SOURCES =================
  subgraph cluster_sources {
    label="Sources (registry / filesystem)";
    style="rounded"; color="#999999"; fontsize=12;
    ctx_files [label="Context Files\nAGENTS.md / CLAUDE.md\nSOUL.md / .cursorrules"];
    skills    [label="skills/\n(bundled skill dirs)"];
  }

  // ================= INBOUND =================
  subgraph cluster_in {
    label="INBOUND";
    style="rounded"; color="#cfcfcf"; fontsize=12;
    platforms [label="Discord / Telegram / Slack\n(Cloud / Bot API / Workspace)", fillcolor="#f8f9fa"];
    adapters_in [label="Platform Adapters (in)"];
    msgevent  [label="MessageEvent\nSessionSource(platform, user_id,\nuser_name, chat_type, ...)"];
    router    [label="Session Router\nbuild_session_key\npairing / allowlist"];
    INTEG_auth [label="★ bridge.is_authorized(source)\nmodule.resolve_user(...) → UserInfo\n(module active → owns auth;\nelse env allowlist fallback)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
    INTEG_login [label="★ bridge.log_message\n(inbound)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
  }

  platforms -> adapters_in -> msgevent -> router;
  router -> INTEG_auth [color="#c92a2a"];
  INTEG_auth -> INTEG_login [color="#c92a2a", style=dashed];

  // ================= CORE: AGENT INIT =================
  subgraph cluster_init {
    label="AIAgent init (run_agent.py) — CLI: per session / gateway: per message";
    style="rounded"; color="#999999"; fontsize=12;
    get_tools [label="get_tool_definitions(enabled, disabled)\ntoolset filter + cache key"];
    INTEG_toolfilter [label="★ _filter_mcp_tools_by_allowlist\navailable_tools(user) ∩ registered MCP\n(built-ins untouched)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
    agent_tools [label="agent.tools / valid_tool_names\n+ memory/context_engine tools\n+ fallback chain + provider init"];
  }

  get_tools -> INTEG_toolfilter [color="#c92a2a"];
  INTEG_toolfilter -> agent_tools;

  // ================= FIRST TURN: PROMPT =================
  subgraph cluster_prompt {
    label="First turn only — system_prompt build (prompt_builder)";
    style="rounded"; color="#999999"; fontsize=12;
    sysprompt [label="system_prompt =\ncontext files + skills snapshot\n+ KANBAN + tool guide"];
    INTEG_ctx [label="★ bridge.context_files(user)\n→ inject file contents", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
    INTEG_skills [label="★ bridge.skills(user)\n→ merge into auto_skill", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
  }

  ctx_files -> sysprompt;
  skills    -> sysprompt;
  INTEG_ctx -> sysprompt [color="#c92a2a", style=dashed];
  INTEG_skills -> sysprompt [color="#c92a2a", style=dashed];

  // ================= AGENT LOOP =================
  subgraph cluster_loop {
    label="AGENT LOOP  (while api_calls < max_iter AND budget)";
    style="rounded"; color="#cfcfcf"; fontsize=12;
    loop [label="① interrupt/budget  ② prepare msgs\n③ LLM call (retry/fallback)\n④ tool exec (built-in / MCP)\n⑤ final-response branch  ⑥ cleanup"];
    mcp_call [label="MCP tool call → tools/mcp_tool.py"];
    INTEG_reconnect [label="★ AUTO-RECONNECT (∞ default)\nbackoff + reset-after-healthy\nTALARIA_MCP_* env tunable", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
  }

  loop -> mcp_call -> INTEG_reconnect [color="#c92a2a"];
  INTEG_reconnect -> mcp_call [color="#c92a2a", style=dashed, label="retry"];

  // ================= OUTBOUND =================
  subgraph cluster_out {
    label="OUTBOUND";
    style="rounded"; color="#cfcfcf"; fontsize=12;
    final [label="final assistant text + metadata"];
    INTEG_logout [label="★ bridge.log_response\n(outbound)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
    adapters_out [label="Platform Adapters (out)"];
    platforms_out [label="Discord / Telegram / Slack"];
  }

  final -> INTEG_logout [color="#c92a2a"];
  INTEG_logout -> adapters_out -> platforms_out;

  // ================= CROSS-CLUSTER FLOW =================
  router -> get_tools [ltail=cluster_in, lhead=cluster_init, label="authorized"];
  agent_tools -> sysprompt [ltail=cluster_init, lhead=cluster_prompt];
  sysprompt -> loop [ltail=cluster_prompt, lhead=cluster_loop];
  loop -> final [ltail=cluster_loop, lhead=cluster_out];

  // module supplies UserInfo to all per-user hooks
  INTEG_auth -> INTEG_toolfilter [color="#c92a2a", style=dotted, constraint=false, label="UserInfo"];
  INTEG_auth -> INTEG_ctx        [color="#c92a2a", style=dotted, constraint=false];
  INTEG_auth -> INTEG_skills     [color="#c92a2a", style=dotted, constraint=false];

  // ---- legend ----
  subgraph cluster_legend {
    label="Legend"; style="rounded"; color="#bbbbbb"; fontsize=11;
    leg_existing [label="existing Talaria box (unchanged)", fillcolor="#ffffff"];
    leg_integ   [label="★ integration hook (new, no-op when no module)", fillcolor="#ffe3e3", color="#c92a2a", penwidth=2];
  }
}
